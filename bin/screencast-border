#!/usr/bin/env bash
# screencast-border — narration window theme (hlwm 0.9.5).
#
# hlwm 0.9.5 has no per-client theming and no border_color rule property,
# so the narration window is themed per-window via the theme sub-objects:
#
#   - narration UNFOCUSED: it is marked urgent; theme.urgent carries the
#     look (#eeeeee outer border + 25px padding, no title) — only urgent
#     windows draw it
#   - narration FOCUSED: theme.active carries the look (only the focused
#     window draws the active theme); restored when focus moves elsewhere
#
# The title is removed with title_when=never (title_height=0 means AUTO
# height in this build and does not hide it). The border is drawn via the
# OUTER border attributes so the color can never bleed into a title strip.
#
# Started by `screencastctl spawn narration`; exits by itself once no
# window of the watched class exists, restoring the saved theme first.
set -u

CLASS="${1:-ScreencastNarr}"
COLOR="${2:-#eeeeee}"
BORDER_W="${SCREENCAST_NARR_BORDER_W:-3}"
PADDING="${SCREENCAST_NARR_PADDING:-25}"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/opencode}/screencast"
mkdir -p "$RUNTIME_DIR"

herb() { herbstclient "$@"; }

# Dedupe via a lock directory holding the owner pid; a stale lock (dead
# owner) is reclaimed. pgrep is not used — it matches parent cmdlines and
# would make the watcher kill itself under wrapper processes.
LOCK="$RUNTIME_DIR/screencast-border.$CLASS.lock"
acquire_lock() {
  if mkdir "$LOCK" 2>/dev/null; then
    printf '%s\n' "$$" > "$LOCK/pid"
    return 0
  fi
  local pid
  pid="$(cat "$LOCK/pid" 2>/dev/null || true)"
  if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
    rm -rf "$LOCK"
    if mkdir "$LOCK" 2>/dev/null; then
      printf '%s\n' "$$" > "$LOCK/pid"
      return 0
    fi
  fi
  return 1
}
if ! acquire_lock; then
  exit 0  # already running
fi

# Save everything we touch, per theme sub-object.
saved_active_outer_w="$(herb attr theme.active.outer_width 2>/dev/null || printf '')"
saved_active_outer_c="$(herb attr theme.active.outer_color 2>/dev/null || printf '')"
saved_active_inner_w="$(herb attr theme.active.inner_width 2>/dev/null || printf '')"
saved_active_inner_c="$(herb attr theme.active.inner_color 2>/dev/null || printf '')"
saved_active_title_when="$(herb attr theme.active.title_when 2>/dev/null || printf '')"
saved_urgent_outer_w="$(herb attr theme.urgent.outer_width 2>/dev/null || printf '')"
saved_urgent_outer_c="$(herb attr theme.urgent.outer_color 2>/dev/null || printf '')"
saved_urgent_inner_w="$(herb attr theme.urgent.inner_width 2>/dev/null || printf '')"
saved_urgent_inner_c="$(herb attr theme.urgent.inner_color 2>/dev/null || printf '')"
saved_urgent_title_when="$(herb attr theme.urgent.title_when 2>/dev/null || printf '')"

restore_active() {
  [[ -n "$saved_active_outer_w" ]] && herb attr theme.active.outer_width "$saved_active_outer_w" 2>/dev/null
  [[ -n "$saved_active_outer_c" ]] && herb attr theme.active.outer_color "$saved_active_outer_c" 2>/dev/null
  [[ -n "$saved_active_inner_w" ]] && herb attr theme.active.inner_width "$saved_active_inner_w" 2>/dev/null
  [[ -n "$saved_active_inner_c" ]] && herb attr theme.active.inner_color "$saved_active_inner_c" 2>/dev/null
  [[ -n "$saved_active_title_when" ]] && herb attr theme.active.title_when "$saved_active_title_when" 2>/dev/null
  return 0
}

cleanup() {
  [[ -n "${idle_pid:-}" ]] && kill "$idle_pid" 2>/dev/null
  rm -f "${FIFO:-}" 2>/dev/null
  restore_active
  herb attr theme.urgent.outer_width "$saved_urgent_outer_w" 2>/dev/null
  herb attr theme.urgent.outer_color "$saved_urgent_outer_c" 2>/dev/null
  herb attr theme.urgent.inner_width "$saved_urgent_inner_w" 2>/dev/null
  herb attr theme.urgent.inner_color "$saved_urgent_inner_c" 2>/dev/null
  herb attr theme.urgent.title_when "$saved_urgent_title_when" 2>/dev/null
  rmdir "$LOCK" 2>/dev/null
}
trap cleanup EXIT INT TERM

# One-time: urgent windows (i.e. the unfocused narration) draw the look —
# COLOR border plus a PADDING px frame around the content (hlwm has no
# padding attribute; the inner border region doubles as padding).
herb attr theme.urgent.outer_color "$COLOR" 2>/dev/null
herb attr theme.urgent.outer_width "$BORDER_W" 2>/dev/null
herb attr theme.urgent.inner_color "$COLOR" 2>/dev/null
herb attr theme.urgent.inner_width "$PADDING" 2>/dev/null
herb attr theme.urgent.title_when never 2>/dev/null

narr_wid() {
  local w
  for w in $(herb list_clients 2>/dev/null); do
    [[ "$(herb attr "clients.$w.class" 2>/dev/null)" == "$CLASS" ]] && { printf '%s' "$w"; return 0; }
  done
  return 1
}

apply_state() {
  local focus_cls="$1" wid
  if [[ "$focus_cls" == "$CLASS" ]]; then
    herb attr theme.active.outer_color "$COLOR" 2>/dev/null
    herb attr theme.active.outer_width "$BORDER_W" 2>/dev/null
    herb attr theme.active.inner_color "$COLOR" 2>/dev/null
    herb attr theme.active.inner_width "$PADDING" 2>/dev/null
    herb attr theme.active.title_when never 2>/dev/null
    wid="$(narr_wid)" && herb attr "clients.$wid.urgent" false 2>/dev/null
  else
    restore_active
    # Unfocused narration: keep it distinct via the urgent theme.
    wid="$(narr_wid)" && herb attr "clients.$wid.urgent" true 2>/dev/null
  fi
}

# Initial pass once the window has mapped (spawn is asynchronous).
( sleep 1.5; apply_state "$(herb attr clients.focus.class 2>/dev/null)" ) &

# React to focus changes; self-terminate when the narration window is gone.
FIFO="$(mktemp -u "$RUNTIME_DIR/screencast-border.XXXXXX")"
mkfifo "$FIFO"
herbstclient --idle > "$FIFO" 2>/dev/null &
idle_pid=$!

while IFS=$'\t' read -r hook wid rest < "$FIFO"; do
  [[ "$hook" == "focus_changed" ]] || continue
  focus_cls="$(herb attr "clients.$wid.class" 2>/dev/null || printf '')"
  if ! narr_wid >/dev/null; then
    exit 0
  fi
  apply_state "$focus_cls"
done
