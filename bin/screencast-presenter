#!/usr/bin/env bash
# screencast-presenter — narration window program.
#
# FLICKER-FREE display: content is only ever appended (tail -F); nothing
# repaints on a timer. Scrollback is purged in the background so the pane
# stays bounded. `screencastctl clear narration` truncates the log and
# appends an ANSI clear marker, which tail forwards to the pane — the view
# wipes without any repaint loop.
#
# When SC_ADVANCE_CMD is set in the tmux session environment, any keypress
# in the window fires it — used to advance a screencast script:
#
#   SC_ADVANCE_CMD="opencode run -s <sessionID> advance"
#
# Keypresses are debounced (2s cooldown) so a hammered Enter cannot queue
# multiple scene skips. The pane title flips to "advancing" during the
# cooldown as visual feedback.
set -u

LOG="${1:?usage: screencast-presenter <logfile>}"
ADV="${SC_ADVANCE_CMD:-}"

title() { printf '\033]2;%s\033\\' "$1"; }
title "narration"

# Key reader: owns the pane's tty; runs alongside the display loop.
# In a non-interactive script bash hands background jobs /dev/null stdin,
# so dup the pane tty to fd 3 synchronously first and read from that.
exec 3<&0
key_reader() {
  local last=0 now
  while read -rsn1 -u 3; do
    now="$(date +%s)"
    (( now < last + 2 )) && continue
    last="$now"
    title "advancing"
    if [[ -n "$ADV" ]]; then
      ( cd "${SC_ADVANCE_DIR:-$PWD}" && nohup sh -c "$ADV" >/dev/null 2>&1 & ) || true
    fi
    sleep 1.5
    title "narration"
  done
}
key_reader &

# Background scrollback purge — invisible (only drops scrolled-off lines).
purge_history() {
  while :; do
    tmux clear-history -t "${TMUX_PANE:?}" 2>/dev/null || true
    sleep 1
  done
}
purge_history &

# Display loop: purely incremental; survives log truncation via -F.
# stderr (tail's "file truncated" notice) is suppressed — the pane must
# only ever show narration content.
exec tail -n +1 -F "$LOG" 2>/dev/null